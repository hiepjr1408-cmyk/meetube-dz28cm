    <string name="meetune_head_tracking">Theo dõi đầu</string>
    <string name="meetune_head_tracking_summary">Âm thanh giữ nguyên vị trí khi bạn xoay đầu, trên tai nghe có theo dõi chuyển động. Bắt đầu từ bài hát tiếp theo</string>
    <string name="meetune_head_tracking_summary_none">Cần Âm thanh không gian của điện thoại này: hãy đeo tai nghe có hỗ trợ và bật tính năng này trong cài đặt Bluetooth của tai nghe</string>
    <string name="meetune_crossfade">Chuyển mờ dần</string>
    <string name="meetune_volume">Âm lượng</string>
    <string name="meetune_volume_note">Chỉ áp dụng cho bài hát; MeeTube giữ âm lượng trình phát riêng. Trên 100% sẽ tăng âm cho bài hát nhỏ tiếng và điện thoại nhỏ tiếng. Mức quá cao có thể làm méo tiếng hoặc hỏng loa</string>
    <string name="meetune_crossfade_off">Tắt</string>
    <string name="meetune_crossfade_seconds">%1$d s</string>
    <string name="meetune_automix">MeeTuneMix</string>
    <string name="meetune_automix_summary">Chuyển mờ như DJ: bài tiếp theo vào đúng nhịp, tempo khớp với bài đang phát, rồi từ từ trở về tempo riêng. Dùng thời lượng Chuyển mờ dần, hoặc 8 giây khi tính năng đó tắt</string>
    <string name="meetune_crossfade_note">Cuối bài hát mờ dần vào bài tiếp theo. Áp dụng cho bài từ Tự động phát, hàng đợi hoặc Lặp lại; không áp dụng khi phát dừng sau bài hát</string>
    <string name="meetune_bit_perfect">USB DAC bit-perfect</string>
    <string name="meetune_bit_perfect_summary">Khi cắm USB DAC, bài hát đến thiết bị nguyên vẹn ở tần số lấy mẫu gốc, bỏ qua bộ trộn âm của Android. Bắt đầu từ bài hát tiếp theo. Để có tín hiệu thuần, hãy để bộ cân bằng âm phẳng, tắt Âm thanh không gian và đặt Âm lượng ở 100%</string>
    <string name="meetune_bit_perfect_summary_none">Cần Android 14 trở lên</string>
