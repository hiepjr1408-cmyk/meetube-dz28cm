    <string name="meetune_spatial_light">Nhẹ</string>
    <string name="meetune_spatial_light_summary">Sân khấu rộng hơn trên tai nghe, gần với bản gốc</string>
    <string name="meetune_spatial_strong">Mạnh</string>
